// First-boot wizard UI.
import "fonts/DancingScript-Regular.ttf";
import "fonts/DancingScript-Bold.ttf";

import { ListView } from "std-widgets.slint";

import { Tokens, Theme, Metrics, Motion } from "theme.slint";
export { Tokens, Theme, Motion } from "theme.slint";
import { Theme as Design, NeptuniaMode } from "../../../kits/neptunia/generated/neptunia.slint";
import {
    Icon, MiniIcon, GlobeIcon, WifiIcon, ClockIcon, ContrastIcon,
    GitIcon, CheckIcon, SpinIcon,
} from "icons.slint";

struct Greet {
    word: string,
    cta: string,
    hint: string,
    size: length,
    rtl: bool,
}

export global State {
    in-out property <int> step: 0;
    in-out property <bool> applying: false;
    in-out property <string> apply-error: "";
    in-out property <string> log-text: "";
    in-out property <bool> show-details: false;
    in-out property <int> prep-phase: 0;
    in-out property <string> prep-status: "";
    in-out property <bool> prep-black: false;
    in-out property <int> error-step: 8;
    in-out property <string> greet-typed: "";
    in-out property <bool> greet-animate: false;
    in-out property <float> intro-op: 0.0;

    in-out property <bool> has-network: false;

    in-out property <string> lang-search: "";
    in-out property <string> lang-selected: "es_MX.UTF-8";
    in-out property <string> lang-selected-name: "Español (México)";
    in-out property <int> kb-index: 0;
    in-out property <string> city-search: "";
    in-out property <string> city-selected: "America/Merida";
    in-out property <string> city-selected-name: "Mérida";
    in-out property <bool> tz-auto: true;
    in-out property <bool> auto-login: false;
    in-out property <bool> git-on: false;

    in-out property <int> net-index: 0;
    in-out property <bool> wifi-pw: false;
    in-out property <int> wifi-connected: -1;
    in-out property <string> wifi-pass: "";
    in-out property <bool> wifi-show: false;
    in-out property <bool> wifi-join: false;
    in-out property <bool> wifi-error: false;
    in-out property <bool> wifi-options: false;
    in-out property <bool> wifi-hidden: false;
    in-out property <string> wifi-ssid: "";

    in-out property <bool> username-editing: false;
    in-out property <bool> form-attempted: false;
    in-out property <int> pw-strength: 0;
    in-out property <bool> pw-match: true;

    in-out property <bool> a11y-large-text: false;
    in-out property <bool> a11y-high-contrast: false;
    in-out property <bool> a11y-screen-reader: false;
    in-out property <bool> a11y-reduce-motion: false;
    in-out property <bool> a11y-screen-keyboard: false;

    in-out property <string> full-name: "";
    in-out property <string> username: "";
    in-out property <string> initials: "";
    in-out property <string> first-name: "";
    in-out property <string> password: "";
    in-out property <string> password2: "";
    in-out property <string> username-error: "";
    in-out property <string> git-name: "";
    in-out property <string> git-email: "";

    in-out property <[Greet]> greets: [
        { word: "hola", cta: "Continuar", hint: "Pulsa Intro para empezar", size: 150px, rtl: false },
        { word: "hello", cta: "Continue", hint: "Press Return to get started", size: 150px, rtl: false },
        { word: "bonjour", cta: "Continuer", hint: "Appuyez sur Entrée pour commencer", size: 140px, rtl: false },
        { word: "olá", cta: "Continuar", hint: "Prima Enter para começar", size: 150px, rtl: false },
        { word: "ciao", cta: "Continua", hint: "Premi Invio per iniziare", size: 150px, rtl: false },
        { word: "hallo", cta: "Weiter", hint: "Drücke die Eingabetaste, um zu beginnen", size: 150px, rtl: false },
        { word: "こんにちは", cta: "続ける", hint: "Return キーを押して開始", size: 96px, rtl: false },
        { word: "你好", cta: "继续", hint: "按回车键开始", size: 110px, rtl: false },
        { word: "안녕하세요", cta: "계속", hint: "Enter 키를 눌러 시작하세요", size: 96px, rtl: false },
        { word: "привет", cta: "Продолжить", hint: "Нажмите Enter, чтобы начать", size: 130px, rtl: false },
        { word: "γεια σου", cta: "Συνέχεια", hint: "Πατήστε Enter για να ξεκινήσετε", size: 124px, rtl: false },
        { word: "merhaba", cta: "Devam", hint: "Başlamak için Enter tuşuna basın", size: 140px, rtl: false },
        { word: "مرحبا", cta: "متابعة", hint: "اضغط على Enter للبدء", size: 120px, rtl: true },
    ];
    in-out property <int> gi: 0;
    in-out property <bool> g-shown: false;

    in-out property <[string]> lang-names: [];
    in-out property <[string]> lang-codes: [];
    in-out property <[string]> suggested-names: ["Español (México)", "English (United States)"];
    in-out property <[string]> suggested-codes: ["es_MX.UTF-8", "en_US.UTF-8"];

    in-out property <[string]> kb-names: [
        "Español (Latinoamérica)", "Español (España)", "U.S.", "Português (Brasil ABNT2)",
        "Français (AZERTY)", "Deutsch", "Italiano", "日本語",
    ];
    in-out property <[string]> kb-codes: ["latam", "es", "us", "br-abnt2", "fr", "de", "it", "jp"];

    in-out property <[string]> net-names: ["Casa", "Casa 5G", "Oficina", "Invitados"];
    in-out property <[bool]> net-lock: [true, true, true, false];

    in-out property <[string]> city-names: [];
    in-out property <[string]> city-tz: [];
}

component StepIcon inherits Rectangle {
    in property <color> tint: Tokens.accent;
    width: 64px;
    height: 64px;
    border-radius: Tokens.radiuslg;
    background: tint;
    border-width: 1px;
    border-color: Design.highlight-border;
    drop-shadow-color: Design.shadow-soft;
    drop-shadow-blur: 16px;
    drop-shadow-offset-y: 6px;
    Rectangle {
        background: @linear-gradient(180deg, Design.highlight-gloss 0%, transparent 60%);
        border-radius: Tokens.radiuslg;
    }
    HorizontalLayout {
        alignment: center;
        VerticalLayout {
            alignment: center;
            @children
        }
    }
}

component TileIcon inherits Rectangle {
    in property <color> tint: Theme.accent;
    in property <string> icon;
    in property <length> size: 24px;
    in property <length> radius: Tokens.radiussm;
    in property <length> glyph-size: 15px;
    width: size;
    height: size;
    border-radius: radius;
    background: tint;
    MiniIcon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        size: root.glyph-size;
        ink: Tokens.onAccent;
        commands: root.icon;
    }
}

component SectionLabel inherits Rectangle {
    in property <string> text;
    height: 28px;
    Text {
        x: 14px;
        text: root.text;
        color: Tokens.inkMuted;
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 0.5px;
        vertical-alignment: center;
        height: parent.height;
    }
}

component Field inherits VerticalLayout {
    in-out property <string> text;
    in property <string> label;
    in property <string> placeholder;
    in property <bool> password: false;
    in property <string> help;
    in property <bool> invalid: false;
    in property <bool> immediate: false;
    property <bool> touched: false;
    property <bool> error: root.invalid && (root.immediate || root.touched || State.form-attempted);
    in property <string> icon;
    in property <bool> reveal: false;
    in-out property <bool> show: false;
    callback edited(string);
    callback accepted();
    spacing: 6px;
    alignment: start;
    Text {
        text: root.label;
        color: Tokens.inkStrong;
        font-weight: 600;
        font-size: 13px * (State.a11y-large-text ? 1.25 : 1.0);
        wrap: no-wrap;
    }
    input := Rectangle {
        width: 100%;
        height: 36px;
        border-radius: Tokens.radiussm;
        background: Tokens.bgSurface;
        border-width: 1px;
        border-color: root.error ? Tokens.danger : (ti.has-focus ? Theme.accent : Tokens.line);
        animate border-color { duration: Motion.fast; }
        animate background { duration: Motion.base; }
        Rectangle {
            x: -4px;
            y: -4px;
            width: parent.width + 8px;
            height: parent.height + 8px;
            border-radius: Tokens.radiussm + 4px;
            background: transparent;
            border-width: 3px;
            border-color: Tokens.accentSoft;
            opacity: (ti.has-focus && !root.error) ? 1 : 0;
            animate opacity { duration: Motion.fast; }
        }
        TouchArea {
            clicked => { ti.focus(); }
        }
        MiniIcon {
            x: 12px;
            y: (parent.height - self.height) / 2;
            size: 16px;
            ink: Tokens.inkFaint;
            visible: root.icon != "";
            commands: root.icon;
        }
        if root.reveal : Rectangle {
            x: parent.width - 6px - 26px;
            y: (parent.height - 26px) / 2;
            width: 26px;
            height: 26px;
            background: transparent;
            eye := TouchArea {
                clicked => { root.show = !root.show; }
            }
            MiniIcon {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                size: 16px;
                ink: eye.has-hover ? Tokens.ink : Tokens.inkMuted;
                commands: "M1.5 8 S3.9 3.5 8 3.5 S14.5 8 14.5 8 S12.1 12.5 8 12.5 S1.5 8 1.5 8 Z M8 10 A2 2 0 1 0 8 6 A2 2 0 1 0 8 10 Z";
            }
        }
        property <length> padL: root.icon != "" ? 38px : 12px;
        property <length> padR: root.reveal ? 42px : 24px;
        Text {
            x: input.padL;
            width: parent.width - input.padL - input.padR;
            height: parent.height;
            text: root.placeholder;
            color: Tokens.inkFaint;
            font-size: 13px * (State.a11y-large-text ? 1.25 : 1.0);
            vertical-alignment: center;
            wrap: no-wrap;
            visible: root.text == "";
        }
        ti := TextInput {
            x: input.padL;
            y: 0;
            width: parent.width - input.padL - input.padR;
            height: parent.height;
            vertical-alignment: center;
            font-size: 13px * (State.a11y-large-text ? 1.25 : 1.0);
            color: Tokens.inkStrong;
            single-line: true;
            input-type: (root.password && !root.show) ? InputType.password : InputType.text;
            text <=> root.text;
            edited => { root.edited(root.text); }
            accepted => { root.accepted(); }
        }
    }
    property <bool> focused: ti.has-focus;
    changed focused => {
        if (!root.focused) { root.touched = true; }
    }
    if root.help != "" : Text {
        text: root.help;
        color: root.error ? Tokens.danger : Tokens.inkMuted;
        font-size: 12px * (State.a11y-large-text ? 1.25 : 1.0);
        wrap: word-wrap;
    }
}

component SearchField inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    callback edited(string);
    height: 36px;
    border-radius: Tokens.radiuspill;
    background: Tokens.bgControl;
    MiniIcon {
        x: 12px;
        y: (parent.height - self.height) / 2;
        size: 16px;
        ink: Tokens.inkFaint;
        commands: "M4 11 A7 7 0 1 0 18 11 A7 7 0 1 0 4 11 Z M20 20 L16 16";
    }
    Text {
        x: 36px;
        width: parent.width - 48px;
        height: parent.height;
        text: root.placeholder;
        color: Tokens.inkFaint;
        font-size: 13px * (State.a11y-large-text ? 1.25 : 1.0);
        vertical-alignment: center;
        wrap: no-wrap;
        visible: root.text == "";
    }
    TextInput {
        x: 36px;
        y: 0;
        width: parent.width - 48px;
        height: parent.height;
        vertical-alignment: center;
        font-size: 13px * (State.a11y-large-text ? 1.25 : 1.0);
        color: Tokens.inkStrong;
        single-line: true;
        text <=> root.text;
        edited => { root.edited(root.text); }
    }
}

component OptionRow inherits Rectangle {
    in property <string> label;
    in property <bool> label-accent: false;
    in property <string> sub;
    in property <bool> sub-accent: false;
    in property <string> trailing;
    in property <bool> trailing-accent: false;
    in property <bool> selected: false;
    in property <bool> divider: true;
    in property <string> icon;
    in property <color> icon-tint: Theme.accent;
    in property <bool> lock: false;
    in property <bool> chevron: false;
    in property <bool> check: false;
    callback picked();
    height: root.sub == "" ? 40px : 52px;
    background: ta.has-hover ? Tokens.bgHover : transparent;
    animate background { duration: Motion.fast; }
    property <length> txtX: root.icon != "" ? 52px : 14px;
    property <length> valR: 14px
        + (root.check ? 22px : 0px)
        + (root.lock ? 22px : 0px)
        + (root.chevron ? 20px : 0px);
    Rectangle {
        y: 0;
        x: root.icon != "" ? 52px : 14px;
        width: parent.width - self.x;
        height: 1px;
        background: root.divider ? Tokens.line : transparent;
    }
    TileIcon {
        x: 14px;
        y: (parent.height - self.height) / 2;
        size: 24px;
        tint: root.icon-tint;
        icon: root.icon;
        visible: root.icon != "";
    }
    Text {
        x: root.txtX;
        y: root.sub == "" ? (parent.height - self.height) / 2 : 9px;
        text: root.label;
        color: root.label-accent ? Theme.accent-strong : Tokens.inkStrong;
        font-size: 13px * (State.a11y-large-text ? 1.25 : 1.0);
        font-weight: 500;
        vertical-alignment: center;
        wrap: no-wrap;
    }
    if root.sub != "" : Text {
        x: root.txtX;
        y: 28px;
        text: root.sub;
        color: root.sub-accent ? Tokens.success : Tokens.inkMuted;
        font-size: 12px * (State.a11y-large-text ? 1.25 : 1.0);
        vertical-alignment: center;
        wrap: no-wrap;
    }
    Text {
        x: parent.width - self.width - root.valR;
        y: (parent.height - self.height) / 2;
        width: parent.width - root.txtX - root.valR - 8px;
        text: root.trailing;
        color: root.trailing-accent ? Theme.accent-strong : Tokens.inkMuted;
        font-size: 12px * (State.a11y-large-text ? 1.25 : 1.0);
        horizontal-alignment: right;
        vertical-alignment: center;
        wrap: no-wrap;
        visible: root.trailing != "";
    }
    MiniIcon {
        x: parent.width - 14px - self.width - (root.check ? 22px : 0px);
        y: (parent.height - self.height) / 2;
        size: 14px;
        sw: 1.6px;
        ink: Tokens.inkFaint;
        visible: root.lock;
        commands: "M4.5 7 V5 A2.5 2.5 0 0 1 9.5 5 V7 M3.5 7 H10.5 V13.5 H3.5 Z";
    }
    MiniIcon {
        x: parent.width - 14px - self.width - (root.check ? 22px : 0px) - (root.lock ? 22px : 0px);
        y: (parent.height - self.height) / 2;
        size: 12px;
        sw: 1.8px;
        ink: Tokens.inkFaint;
        visible: root.chevron;
        commands: "M3.5 5 L8 9.5 L12.5 5";
    }
    if root.check : Rectangle {
        x: parent.width - self.width - 14px;
        y: (parent.height - self.height) / 2;
        width: 14px;
        height: 14px;
        opacity: root.selected ? 1 : 0;
        transform-scale-x: root.selected ? 100% : 60%;
        transform-scale-y: root.selected ? 100% : 60%;
        animate opacity { duration: Motion.fast; }
        animate transform-scale-x { duration: Motion.fast; }
        animate transform-scale-y { duration: Motion.fast; }
        MiniIcon {
            x: 0;
            y: 0;
            size: 14px;
            sw: 2.2px;
            ink: Theme.accent;
            commands: "M1 6.5 L5 10.5 L13 2.5";
        }
    }
    ta := TouchArea {
        clicked => { root.picked(); }
    }
}

component ListCard inherits Rectangle {
    width: 100%;
    border-radius: Tokens.radiuslg;
    background: Tokens.bgSurface;
    border-width: 1px;
    border-color: Tokens.line;
    clip: true;
    VerticalLayout {
        alignment: start;
        padding-top: 4px;
        padding-bottom: 4px;
        spacing: 0px;
        @children
    }
}

component Toggle inherits Rectangle {
    in-out property <bool> checked;
    width: 36px;
    height: 20px;
    border-radius: Tokens.radiuspill;
    background: checked ? Theme.accent : Tokens.bgControl;
    border-width: checked ? 0px : 1px;
    border-color: Tokens.line;
    animate background { duration: Motion.fast; }
    animate border-color { duration: Motion.fast; }
    Rectangle {
        width: 16px;
        height: 16px;
        border-radius: 8px;
        background: Tokens.onAccent;
        drop-shadow-color: Design.knob-shadow;
        drop-shadow-blur: 3px;
        drop-shadow-offset-y: 1px;
        x: root.checked ? parent.width - self.width - 2px : 2px;
        y: 2px;
        animate x { duration: Motion.fast; }
    }
    TouchArea {
        clicked => { root.checked = !root.checked; }
    }
}

component IconRow inherits Rectangle {
    in property <string> title;
    in property <string> desc;
    in property <string> icon;
    in property <color> tint: Theme.accent;
    in-out property <bool> on;
    in property <bool> divider: true;
    height: 48px;
    Rectangle {
        y: 0;
        x: 50px;
        width: parent.width - 64px;
        height: 1px;
        background: root.divider ? Tokens.line : transparent;
    }
    TileIcon {
        x: 14px;
        y: (parent.height - self.height) / 2;
        tint: root.tint;
        icon: root.icon;
    }
    Text {
        x: 50px;
        y: 7px;
        height: 18px;
        text: root.title;
        color: Tokens.inkStrong;
        font-size: 13px * (State.a11y-large-text ? 1.25 : 1.0);
        font-weight: 500;
        vertical-alignment: center;
    }
    Text {
        x: 50px;
        y: 25px;
        width: parent.width - 110px;
        height: 16px;
        text: root.desc;
        color: Tokens.inkMuted;
        font-size: 12px * (State.a11y-large-text ? 1.25 : 1.0);
        vertical-alignment: center;
        wrap: no-wrap;
        overflow: elide;
    }
    TouchArea {
        clicked => { root.on = !root.on; }
    }
    Toggle {
        x: parent.width - self.width - 14px;
        y: (parent.height - self.height) / 2;
        checked <=> root.on;
    }
}


component Button inherits Rectangle {
    in property <string> label;
    in property <bool> primary: false;
    in property <bool> enabled: true;
    in property <length> w: 112px;
    in property <length> h: Tokens.controllg;
    callback clicked();
    width: w;
    height: root.h;
    border-radius: Tokens.radiusButton;
    background: primary
        ? (ta.pressed ? Theme.accent-strong : (ta.has-hover ? Tokens.accentHover : Theme.accent))
        : (ta.has-hover || ta.pressed ? Tokens.bgHover : Tokens.bgControl);
    opacity: root.enabled ? 1 : 0.4;
    animate background { duration: Motion.fast; }
    Text {
        text: root.label;
        color: primary ? Theme.accent-ink : Tokens.inkStrong;
        font-size: 13px * (State.a11y-large-text ? 1.25 : 1.0);
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: parent.width;
        height: parent.height;
        wrap: no-wrap;
    }
    ta := TouchArea {
        clicked => { if (root.enabled) { root.clicked(); } }
    }
}

component LinkText inherits Rectangle {
    in property <string> label;
    in property <color> fg: Theme.accent-strong;
    in property <length> w;
    callback clicked();
    width: w;
    height: 22px;
    background: transparent;
    Text {
        text: root.label;
        color: root.fg;
        font-size: 13px * (State.a11y-large-text ? 1.25 : 1.0);
        font-weight: 500;
        vertical-alignment: center;
        horizontal-alignment: center;
        width: parent.width;
        height: parent.height;
        wrap: no-wrap;
    }
    TouchArea {
        clicked => { root.clicked(); }
    }
}

component ModeCard inherits Rectangle {
    in property <bool> preview-dark: false;
    in property <bool> selected: false;
    callback picked();
    width: 166px;
    height: 124px;
    background: transparent;
    VerticalLayout {
        alignment: center;
        spacing: 8px;
        Rectangle {
            width: 154px;
            height: 98px;
            border-radius: Tokens.radiusmd + 2px;
            background: transparent;
            border-width: 2px;
            border-color: root.selected ? Theme.accent : transparent;
            Rectangle {
                x: 2px;
                y: 2px;
                width: parent.width - 4px;
                height: parent.height - 4px;
                border-radius: Tokens.radiusmd;
                clip: true;
                background: root.preview-dark ? Design.preview-dark-sunken : Design.preview-light-sunken;
                Rectangle {
                    x: 22px;
                    y: 18px;
                    width: 106px;
                    height: 62px;
                    border-radius: Tokens.radiussm;
                    background: root.preview-dark ? Design.preview-dark-window : Design.preview-light-window;
                    border-width: root.preview-dark ? 1px : 0px;
                    border-color: black;
                    Rectangle {
                        x: 10px;
                        y: 12px;
                        width: 40px;
                        height: 7px;
                        border-radius: Tokens.radiusxs;
                        background: Theme.accent;
                    }
                    Rectangle {
                        x: 10px;
                        y: 26px;
                        width: 70px;
                        height: 5px;
                        border-radius: Tokens.radiusxs;
                        background: root.preview-dark ? Design.preview-dark-control : Design.preview-light-control;
                    }
                }
            }
        }
        Text {
            text: root.preview-dark ? @tr("Oscuro") : @tr("Claro");
            color: Tokens.ink;
            font-size: 13px * (State.a11y-large-text ? 1.25 : 1.0);
            font-weight: 500;
            horizontal-alignment: center;
        }
    }
    TouchArea {
        clicked => { root.picked(); }
    }
}

component Swatch inherits Rectangle {
    in property <color> c;
    in property <bool> selected: false;
    callback picked();
    width: 32px;
    height: 32px;
    background: transparent;
    Rectangle {
        width: 32px;
        height: 32px;
        border-radius: 16px;
        background: transparent;
        border-width: 2px;
        border-color: root.selected ? root.c : transparent;
        animate border-color { duration: Motion.fast; }
    }
    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 28px;
        height: 28px;
        border-radius: 14px;
        background: root.selected ? (Tokens.dark ? Tokens.bgRaised : Tokens.bgWindow) : transparent;
        animate background { duration: Motion.fast; }
    }
    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 24px;
        height: 24px;
        border-radius: 12px;
        background: root.c;
    }
    TouchArea {
        clicked => { root.picked(); }
    }
}

component SummaryRow inherits Rectangle {
    in property <string> k;
    in property <string> v;
    in property <string> icon;
    in property <color> tint;
    in property <bool> divider: true;
    height: 32px;
    Rectangle {
        y: 0;
        x: 50px;
        width: parent.width - 64px;
        height: 1px;
        background: root.divider ? Tokens.line : transparent;
    }
    TileIcon {
        x: 14px;
        y: (parent.height - self.height) / 2;
        tint: root.tint;
        icon: root.icon;
    }
    Text {
        x: 50px;
        text: root.k;
        color: Tokens.inkMuted;
        font-size: 13px * (State.a11y-large-text ? 1.25 : 1.0);
        vertical-alignment: center;
        height: parent.height;
        wrap: no-wrap;
    }
    Text {
        x: parent.width - self.width - 14px;
        text: root.v;
        color: Tokens.inkStrong;
        font-size: 13px * (State.a11y-large-text ? 1.25 : 1.0);
        font-weight: 500;
        vertical-alignment: center;
        height: parent.height;
        wrap: no-wrap;
        overflow: elide;
    }
}

component StepHeader inherits VerticalLayout {
    in property <string> title;
    in property <string> subtitle;
    alignment: start;
    spacing: 14px;
    HorizontalLayout {
        alignment: center;
        @children
    }
    VerticalLayout {
        alignment: start;
        spacing: 6px;
        Text {
            text: root.title;
            font-size: 22px * (State.a11y-large-text ? 1.25 : 1.0);
            font-weight: 650;
            color: Tokens.inkStrong;
            horizontal-alignment: center;
            animate color { duration: Motion.base; }
        }
        Text {
            text: root.subtitle;
            font-size: 13px * (State.a11y-large-text ? 1.25 : 1.0);
            color: Tokens.inkMuted;
            horizontal-alignment: center;
            wrap: word-wrap;
            animate color { duration: Motion.base; }
        }
    }
}

export component AppWindow inherits Window {
    title: "Assist-setup";
    width: 1280px;
    height: 800px;
    background: Design.wallpaper-fallback;
    default-font-family: "Inter";
    forward-focus: key-handler;

    in-out property <int> step <=> State.step;
    changed step => { if (State.step == 4) { State.form-attempted = false; } }
    in-out property <string> theme <=> Tokens.theme;
    changed theme => {
        Design.mode = theme == "dark" ? NeptuniaMode.dark : theme == "dark-tint" ? NeptuniaMode.dark-tint : NeptuniaMode.light;
    }
    in-out property <int> greet <=> State.gi;
    in-out property <bool> tz-auto <=> State.tz-auto;
    in-out property <int> prep-phase <=> State.prep-phase;
    in-out property <string> apply-error <=> State.apply-error;

    callback quit-app();
    callback apply();
    callback name-edited(string);
    callback username-edited(string);
    callback language-changed(string);
    callback lang-search-changed(string);
    callback city-search-changed(string);
    callback passwords-changed();
    callback wifi-connect();
    callback reduce-changed(bool);

    property <bool> reduce: Theme.reduced-motion || State.a11y-reduce-motion;
    init => { Motion.reduce = root.reduce; root.reduce-changed(root.reduce); }
    changed reduce => { Motion.reduce = root.reduce; root.reduce-changed(root.reduce); }

    out property <bool> in-dlg: State.step >= 1 && State.step <= 8;

    in-out property <image> wallpaper: @image-url("firstboot-blur.jpg");
    out property <float> bg-scale: (Motion.reduce || State.step != 0)
        ? 1.0
        : (1.0 + 0.04 * root.bg-tri(animation-tick()));
    function bg-tri(t: duration) -> float {
        return mod(t, 60s) / 30s <= 1 ? mod(t, 60s) / 30s : 2 - mod(t, 60s) / 30s;
    }

    function off(i: int) -> length {
        return Motion.reduce ? 0px : (State.step == i ? 0px : (State.step > i ? -32px : 32px));
    }
    function op(i: int) -> float {
        return State.step == i ? 1.0 : 0.0;
    }
    function status-label(p: int) -> string {
        return p == 0 ? @tr("Creando tu cuenta…")
            : p == 1 ? @tr("Aplicando idioma y región…")
            : p == 2 ? @tr("Construyendo el sistema…")
            : p == 3 ? @tr("Instalando la entrada de arranque…")
            : @tr("Listo. Reiniciando…");
    }
    function next-step(s: int) -> int {
        return (s + 1 == 3 && State.has-network) ? 4 : s + 1;
    }
    function prev-step(s: int) -> int {
        return (s - 1 == 3 && State.has-network) ? 2 : s - 1;
    }
    function step-tint(i: int) -> color {
        return i == 1 ? Tokens.sysPurple
            : i == 2 ? Tokens.sysBlue
            : i == 3 ? Tokens.sysCyan
            : i == 5 ? Tokens.sysOrange
            : i == 6 ? Tokens.sysPurple
            : i == 7 ? Tokens.sysGreen
            : Tokens.sysBlue;
    }
    function greet-family(i: int) -> string {
        return i >= 6 && i <= 8 ? "Noto Sans CJK SC"
            : (i >= 9 && i <= 10 ? "DejaVu Sans" : (i == 12 ? "DejaVu Sans" : "Dancing Script"));
    }
    function greet-weight(i: int) -> int {
        return (i <= 5 || i == 11) ? 600 : 400;
    }
    function a11y-join(acc: string, on: bool, name: string) -> string {
        return on ? (acc == "" ? name : acc + ", " + name) : acc;
    }
    function a11y-summary() -> string {
        return a11y-join(
            a11y-join(
                a11y-join(
                    a11y-join(
                        a11y-join("", State.a11y-large-text, @tr("Texto grande")),
                        State.a11y-high-contrast, @tr("Alto contraste")),
                    State.a11y-screen-reader, @tr("Lector de pantalla")),
                State.a11y-reduce-motion, @tr("Reducir animaciones")),
            State.a11y-screen-keyboard, @tr("Teclado en pantalla"));
    }
    function cuenta-valid() -> bool {
        return State.full-name != ""
            && State.username != ""
            && State.username-error == ""
            && State.password != ""
            && State.password2 == State.password;
    }
    function continue-clicked() {
        if (State.step == 8) { root.apply(); }
        else if (State.step == 4 && !root.cuenta-valid()) { State.form-attempted = true; }
        else { State.step = root.next-step(State.step); }
    }
    function set-language(code: string) {
        State.lang-selected = code;
        root.language-changed(code);
    }
    function pick-city(name: string, zone: string) {
        State.city-selected = zone;
        State.city-selected-name = name;
    }
    function pick-network(i: int) {
        State.net-index = i;
        State.wifi-error = false;
        State.wifi-hidden = false;
        if (State.net-lock[i]) {
            State.wifi-pw = true;
            State.wifi-pass = "";
            State.wifi-show = false;
        } else {
            State.wifi-connected = i;
        }
    }
    function open-hidden-network() {
        State.wifi-options = false;
        State.wifi-hidden = true;
        State.wifi-pw = true;
        State.wifi-ssid = "";
        State.wifi-pass = "";
        State.wifi-show = false;
        State.wifi-error = false;
    }
    function wifi-back() {
        State.wifi-pw = false;
        State.wifi-join = false;
        State.wifi-error = false;
        State.wifi-hidden = false;
    }
    function wifi-join-now() {
        State.wifi-error = false;
        State.wifi-join = true;
        root.wifi-connect();
    }
    property <int> shake-step: 0;
    property <length> shake-x: (Motion.reduce || root.shake-step == 0) ? 0px
        : (Math.mod(root.shake-step, 2) == 1 ? 6px : -6px);
    Timer {
        interval: 55ms;
        running: root.shake-step > 0;
        triggered => {
            root.shake-step = root.shake-step + 1;
            if (root.shake-step > 6) { root.shake-step = 0; }
        }
    }
    in-out property <bool> wifi-error-watch <=> State.wifi-error;
    changed wifi-error-watch => { if (root.wifi-error-watch) { root.shake-step = 1; } }

    key-handler := FocusScope {
    width: 100%;
    height: 100%;
    KeyBinding {
        keys: @keys(Escape);
        activated => { if (State.wifi-pw) { root.wifi-back(); } else { root.quit-app(); } }
    }
    KeyBinding {
        keys: @keys(Return);
        activated => {
            if (State.step == 3 && State.wifi-pw) { root.wifi-join-now(); }
            else if (State.step == 0) { State.step = 1; }
        }
    }

    Image {
        source: root.wallpaper;
        width: parent.width;
        height: parent.height;
        image-fit: cover;
        transform-scale-x: root.bg-scale;
        transform-scale-y: root.bg-scale;
    }
    Rectangle {
        width: parent.width;
        height: parent.height;
        background: Design.wallpaper-veil;
    }

    hello := Rectangle {
        width: parent.width;
        height: parent.height;
        opacity: State.step == 0 ? 1 : 0;
        transform-scale-x: Motion.reduce ? 100% : (State.step == 0 ? 100% : 104%);
        transform-scale-y: Motion.reduce ? 100% : (State.step == 0 ? 100% : 104%);
        visible: self.opacity > 0.001;
        animate opacity { duration: Motion.slow; easing: ease-out; }
        animate transform-scale-x { duration: Motion.slow; easing: ease-out; }
        animate transform-scale-y { duration: Motion.slow; easing: ease-out; }

        Rectangle {
            width: parent.width;
            height: parent.height;
            background: transparent;
            opacity: State.intro-op;
            animate opacity { duration: Motion.reduce ? 0ms : 700ms; easing: ease-out; }
            VerticalLayout {
                alignment: center;
                spacing: 10px;
                Text {
                    text: "Welcome to NixOS";
                    color: Tokens.onAccent;
                    font-family: "Inter";
                    font-size: 30px;
                    font-weight: 600;
                    letter-spacing: -0.4px;
                    horizontal-alignment: center;
                }
                Text {
                    text: "ASSIST-SETUP";
                    color: rgba(255, 255, 255, 0.7);
                    font-family: "Inter";
                    font-size: 12px;
                    font-weight: 600;
                    letter-spacing: 1.9px;
                    horizontal-alignment: center;
                }
            }
        }

        VerticalLayout {
            width: 100%;
            height: 100%;
            padding-bottom: 40px;
            alignment: center;
            Rectangle {
                width: 100%;
                height: 200px;
                opacity: State.g-shown ? 1 : 0;
                animate opacity { duration: Motion.reduce ? 0ms : 450ms; }
                Text {
                    width: 100%;
                    height: 100%;
                    text: State.greet-animate ? State.greet-typed : State.greets[State.gi].word;
                    color: Design.wallpaper-ink-soft;
                    font-family: root.greet-family(State.gi);
                    font-weight: root.greet-weight(State.gi);
                    font-size: State.greets[State.gi].size;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                    wrap: no-wrap;
                }
            }
        }

        Rectangle {
            width: 100%;
            height: 68px;
            y: parent.height - self.height - 120px;
            opacity: State.g-shown ? 1 : 0;
            animate opacity { duration: Motion.reduce ? 0ms : 450ms; }
            VerticalLayout {
                width: 100%;
                alignment: center;
                spacing: 12px;
                HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        width: 180px;
                        height: Tokens.controllg;
                        border-radius: Tokens.radiusButton;
                        background: ta.pressed ? Theme.accent-strong : (ta.has-hover ? Tokens.accentHover : Theme.accent);
                        transform-scale-x: ta.pressed ? 97% : 100%;
                        transform-scale-y: ta.pressed ? 97% : 100%;
                        drop-shadow-color: Design.wallpaper-shadow;
                        drop-shadow-blur: 16px;
                        drop-shadow-offset-y: 4px;
                        animate background { duration: Motion.fast; }
                        HorizontalLayout {
                            y: 0;
                            width: 100%;
                            height: 100%;
                            alignment: center;
                            spacing: 8px;
                            Text {
                                text: State.greets[State.gi].cta;
                                color: Tokens.onAccent;
                                font-family: "Inter";
                                font-size: 13px;
                                font-weight: 600;
                                wrap: no-wrap;
                                height: 100%;
                                vertical-alignment: center;
                                opacity: State.g-shown ? 1 : 0;
                                animate opacity { duration: Motion.reduce ? 0ms : 450ms; }
                            }
                            VerticalLayout {
                                alignment: center;
                                MiniIcon {
                                    size: 14px;
                                    sw: 2px;
                                    ink: Tokens.onAccent;
                                    commands: State.greets[State.gi].rtl
                                        ? "M19 12 L5 12 M11 6 L5 12 L11 18"
                                        : "M5 12 L19 12 M13 6 L19 12 L13 18";
                                }
                            }
                        }
                        ta := TouchArea {
                            clicked => { State.step = 1; }
                        }
                    }
                }
                Text {
                    text: State.greets[State.gi].hint;
                    color: Design.wallpaper-ink-hint;
                    font-size: 14px;
                    horizontal-alignment: center;
                    opacity: State.g-shown ? 1 : 0;
                    animate opacity { duration: Motion.reduce ? 0ms : 450ms; }
                }
            }
        }
    }

    dialog := Rectangle {
        width: 880px;
        height: 648px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: transparent;
        opacity: root.in-dlg ? 1 : 0;
        transform-scale-x: Motion.reduce ? 100% : (root.in-dlg ? 100% : 97%);
        transform-scale-y: Motion.reduce ? 100% : (root.in-dlg ? 100% : 97%);
        visible: self.opacity > 0.001;
        animate opacity { duration: Motion.slow; easing: ease-out; delay: Motion.reduce ? 0ms : 180ms; }
        animate transform-scale-x { duration: Motion.slow; easing: ease-out; delay: Motion.reduce ? 0ms : 180ms; }
        animate transform-scale-y { duration: Motion.slow; easing: ease-out; delay: Motion.reduce ? 0ms : 180ms; }

        Rectangle {
            width: 100%;
            height: 100%;
            border-radius: Tokens.radiuslg;
            background: Tokens.dark ? Tokens.bgRaised : Tokens.bgWindow;
            drop-shadow-color: rgba(0, 0, 0, Tokens.dark ? 0.55 : 0.18);
            drop-shadow-blur: 48px;
            drop-shadow-offset-y: 24px;
            animate background { duration: Motion.base; }
        }
        Rectangle {
            width: 100%;
            height: 100%;
            border-radius: Tokens.radiuslg;
            background: Tokens.dark ? Tokens.bgRaised : Tokens.bgWindow;
            border-width: 1px;
            border-color: Tokens.windowOuter;
            drop-shadow-color: rgba(0, 0, 0, Tokens.dark ? 0.35 : 0.12);
            drop-shadow-blur: 12px;
            drop-shadow-offset-y: 4px;
            animate background { duration: Motion.base; }
        }

        Rectangle {
            x: 130px;
            y: 36px;
            width: 620px;
            height: 548px;
            clip: true;

                p1 := Rectangle {
                    width: 100%;
                    height: 100%;
                    x: root.off(1);
                    opacity: root.op(1);
                    visible: self.opacity > 0.001;
                    animate x { duration: Motion.reduce ? 0ms : Motion.base; easing: ease-out; }
                    animate opacity { duration: Motion.reduce ? 0ms : Motion.base; easing: ease-out; }
                    VerticalLayout {
                        height: 100%;
                        alignment: start;
                        spacing: 12px;
                        StepHeader {
                            title: @tr("Idioma y región");
                            subtitle: @tr("Se usará en el sistema, las apps y GNOME.");
                            StepIcon { tint: root.step-tint(1); GlobeIcon { ink: Tokens.onAccent; size: 30px; } }
                        }
                        SearchField {
                            placeholder: @tr("Buscar idioma o región");
                            text <=> State.lang-search;
                            edited(t) => { root.lang-search-changed(t); }
                        }
                        ListCard {
                            SectionLabel { text: @tr("SUGERIDOS"); }
                            for i in State.suggested-codes.length : OptionRow {
                                label: State.suggested-names[i];
                                trailing: State.suggested-codes[i];
                                check: true;
                                selected: State.lang-selected == State.suggested-codes[i];
                                divider: i > 0;
                                picked => { root.set-language(State.suggested-codes[i]); }
                            }
                        }
                        Rectangle {
                            width: 100%;
                            height: 168px;
                            border-radius: Tokens.radiuslg;
                            background: Tokens.bgSurface;
                            border-width: 1px;
                            border-color: Tokens.line;
                            clip: true;
                            ListView {
                                for name[i] in State.lang-names : OptionRow {
                                    label: name;
                                    trailing: State.lang-codes[i];
                                    check: true;
                                    selected: State.lang-selected == State.lang-codes[i];
                                    divider: i > 0;
                                    picked => { root.set-language(State.lang-codes[i]); }
                                }
                            }
                        }
                        ListCard {
                            OptionRow {
                                label: @tr("Teclado");
                                trailing: State.kb-names[State.kb-index];
                                chevron: true;
                                divider: false;
                                picked => { State.kb-index = Math.mod(State.kb-index + 1, State.kb-names.length); }
                            }
                        }
                    }
                }

                p2 := Rectangle {
                    width: 100%;
                    height: 100%;
                    x: root.off(2);
                    opacity: root.op(2);
                    visible: self.opacity > 0.001;
                    animate x { duration: Motion.reduce ? 0ms : Motion.base; easing: ease-out; }
                    animate opacity { duration: Motion.reduce ? 0ms : Motion.base; easing: ease-out; }
                    VerticalLayout {
                        alignment: start;
                        spacing: 20px;
                        StepHeader {
                            title: @tr("Accesibilidad");
                            subtitle: @tr("Actívalo ahora si lo necesitas para seguir. Puedes cambiarlo después en Ajustes.");
                            StepIcon {
                                tint: root.step-tint(2);
                                Icon {
                                    size: 30px;
                                    ink: Tokens.onAccent;
                                    commands: "M 12 2.9 A 1.6 1.6 0 1 0 12 6.1 A 1.6 1.6 0 1 0 12 2.9 Z M 5 8.5 C 7.3 9.2 9.6 9.5 12 9.5 C 14.4 9.5 16.7 9.2 19 8.5 M 12 9.5 L 12 14 M 9 21 L 12 14 L 15 21";
                                }
                            }
                        }
                        VerticalLayout {
                            alignment: start;
                            spacing: 14px;
                            ListCard {
                                SectionLabel { text: @tr("VISIÓN"); }
                                IconRow {
                                    title: @tr("Texto grande"); desc: @tr("Aumenta el tamaño del texto un 25 %");
                                    icon: "M1.5 12.5 L5 3.5 L8.5 12.5 M2.7 9.5 H7.3 M10 12.5 L12.25 6.5 L14.5 12.5 M10.7 10.7 H13.8";
                                    tint: Tokens.sysOrange;
                                    on <=> State.a11y-large-text;
                                }
                                IconRow {
                                    title: @tr("Alto contraste"); desc: @tr("Bordes y texto más marcados");
                                    icon: "M8 1.5 A6.5 6.5 0 1 0 8 14.5 A6.5 6.5 0 1 0 8 1.5 Z M8 1.5 L8 14.5 M8 4.5 H12 M8 8 H13.5 M8 11.5 H12";
                                    tint: Tokens.sysGray;
                                    on <=> State.a11y-high-contrast;
                                }
                                IconRow {
                                    title: @tr("Lector de pantalla"); desc: @tr("Orca lee en voz alta lo que hay en pantalla");
                                    icon: "M2.5 6 H5 L8.5 3 V13 L5 10 H2.5 Z M11 5.5 A3.5 3.5 0 0 1 11 10.5 M12.8 3.5 A6.3 6.3 0 0 1 12.8 12.5";
                                    tint: Tokens.sysRed;
                                    on <=> State.a11y-screen-reader;
                                }
                                SectionLabel { text: @tr("MOVIMIENTO E INTERACCIÓN"); }
                                IconRow {
                                    title: @tr("Reducir animaciones"); desc: @tr("Desactiva las animaciones de GNOME");
                                    icon: "M1.5 8 H4.5 M2.5 5 H5.5 M2.5 11 H5.5 M8 8 A3 3 0 1 0 14 8 A3 3 0 1 0 8 8 Z";
                                    tint: Tokens.sysPurple;
                                    on <=> State.a11y-reduce-motion;
                                }
                                IconRow {
                                    title: @tr("Teclado en pantalla"); desc: @tr("Aparece al escribir en un campo de texto");
                                    icon: "M1.5 4 H14.5 V12 H1.5 Z M4 7 H5 M7 7 H9 M11 7 H12 M5 9.5 H11";
                                    tint: Tokens.sysCyan;
                                    divider: false;
                                    on <=> State.a11y-screen-keyboard;
                                }
                            }
                            HorizontalLayout {
                                alignment: center;
                                LinkText {
                                    label: @tr("Ahora no");
                                    w: 120px;
                                    clicked => { State.step = root.next-step(2); }
                                }
                            }
                        }
                    }
                }

                p3 := Rectangle {
                    width: 100%;
                    height: 100%;
                    x: root.off(3);
                    opacity: root.op(3);
                    visible: self.opacity > 0.001;
                    animate x { duration: Motion.reduce ? 0ms : Motion.base; easing: ease-out; }
                    animate opacity { duration: Motion.reduce ? 0ms : Motion.base; easing: ease-out; }

                    Rectangle {
                        width: 100%;
                        height: 100%;
                        x: State.wifi-pw ? -parent.width : 0px;
                        opacity: State.wifi-pw ? 0 : 1;
                        visible: self.opacity > 0.001;
                        animate x { duration: Motion.reduce ? 0ms : Motion.base; easing: ease-out; }
                        animate opacity { duration: Motion.reduce ? 0ms : Motion.base; easing: ease-out; }
                        VerticalLayout {
                            alignment: start;
                            spacing: 20px;
                            StepHeader {
                                title: @tr("Conéctate a una red");
                                subtitle: @tr("Solo aparece si no hay cable ni Wi‑Fi conectado.");
                                StepIcon { tint: root.step-tint(3); WifiIcon { ink: Tokens.onAccent; size: 30px; } }
                            }
                            ListCard {
                                SectionLabel { text: @tr("REDES DISPONIBLES"); }
                                for name[i] in State.net-names : OptionRow {
                                    label: name;
                                    sub: i == State.wifi-connected ? @tr("Conectada")
                                        : (State.net-lock[i] ? @tr("Protegida") : @tr("Abierta"));
                                    sub-accent: i == State.wifi-connected;
                                    icon: "M2 6.5 A9 9 0 0 1 14 6.5 M4.2 9 A5.8 5.8 0 0 1 11.8 9 M6.5 11.4 A2.4 2.4 0 0 1 9.5 11.4";
                                    icon-tint: Tokens.sysCyan;
                                    lock: State.net-lock[i];
                                    check: true;
                                    selected: i == State.wifi-connected;
                                    divider: i > 0;
                                    picked => { root.pick-network(i); }
                                }
                            }
                            HorizontalLayout {
                                alignment: center;
                                LinkText {
                                    label: @tr("Continuar sin conexión");
                                    w: 200px;
                                    clicked => { State.step = 4; }
                                }
                            }
                        }
                    }

                    Rectangle {
                        width: 100%;
                        height: 100%;
                        x: State.wifi-pw ? 0px : parent.width;
                        opacity: State.wifi-pw ? 1 : 0;
                        visible: State.wifi-pw;
                        animate x { duration: Motion.reduce ? 0ms : Motion.base; easing: ease-out; }
                        animate opacity { duration: Motion.reduce ? 0ms : Motion.base; easing: ease-out; }
                        VerticalLayout {
                            alignment: start;
                            spacing: 16px;
                            Rectangle {
                                width: 110px;
                                height: 24px;
                                border-radius: Tokens.radiussm;
                                background: back-ta.has-hover ? Tokens.bgHover : transparent;
                                back-ta := TouchArea {
                                    clicked => { root.wifi-back(); }
                                }
                                Text {
                                    x: 4px;
                                    text: "‹ " + @tr("Redes");
                                    color: Theme.accent-strong;
                                    font-size: 13px * (State.a11y-large-text ? 1.25 : 1.0);
                                    font-weight: 500;
                                    vertical-alignment: center;
                                    height: parent.height;
                                }
                            }
                            HorizontalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 64px;
                                    height: 64px;
                                    border-radius: Tokens.radiuslg;
                                    background: Tokens.sysCyan;
                                    Rectangle {
                                        background: @linear-gradient(180deg, Design.highlight-gloss 0%, transparent 60%);
                                        border-radius: Tokens.radiuslg;
                                    }
                                    WifiIcon {
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        size: 30px;
                                        ink: Tokens.onAccent;
                                    }
                                    Rectangle {
                                        x: parent.width - self.width + 6px;
                                        y: parent.height - self.height + 6px;
                                        width: 26px;
                                        height: 26px;
                                        border-radius: Tokens.radiuspill;
                                        background: Tokens.bgRaised;
                                        drop-shadow-color: Design.shadow-soft;
                                        drop-shadow-blur: 12px;
                                        drop-shadow-offset-y: 4px;
                                        MiniIcon {
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                            size: 13px;
                                            sw: 1.8px;
                                            ink: Tokens.inkStrong;
                                            commands: "M4.5 7 V5 A2.5 2.5 0 0 1 9.5 5 V7 M3.5 7 H10.5 V13.5 H3.5 Z";
                                        }
                                    }
                                }
                            }
                            VerticalLayout {
                                alignment: start;
                                spacing: 6px;
                                Text {
                                    text: State.wifi-hidden
                                        ? @tr("Red oculta")
                                        : @tr("Introduce la contraseña de") + " «" + State.net-names[State.net-index] + "»";
                                    color: Tokens.inkStrong;
                                    font-size: 22px * (State.a11y-large-text ? 1.25 : 1.0);
                                    font-weight: 650;
                                    horizontal-alignment: center;
                                    wrap: word-wrap;
                                }
                                Text {
                                    text: State.wifi-hidden
                                        ? @tr("Escribe el nombre y la contraseña de la red.")
                                        : @tr("Esta red está protegida. Escribe su contraseña para unirte.");
                                    color: Tokens.inkMuted;
                                    font-size: 13px * (State.a11y-large-text ? 1.25 : 1.0);
                                    horizontal-alignment: center;
                                    wrap: word-wrap;
                                }
                            }
                            Rectangle {
                                width: 100%;
                                height: pw-inner.preferred-height;
                                background: transparent;
                                x: root.shake-x;
                                animate x { duration: Motion.reduce ? 0ms : 60ms; }
                                pw-inner := VerticalLayout {
                                    alignment: start;
                                    spacing: 14px;
                                    if State.wifi-hidden : Field {
                                        label: @tr("Nombre de la red");
                                        icon: "M2 6.5 A9 9 0 0 1 14 6.5 M4.2 9 A5.8 5.8 0 0 1 11.8 9 M6.5 11.4 A2.4 2.4 0 0 1 9.5 11.4";
                                        text <=> State.wifi-ssid;
                                    }
                                    Field {
                                        label: @tr("Contraseña");
                                        password: true;
                                        icon: "M4.5 7 V5 A2.5 2.5 0 0 1 9.5 5 V7 M3.5 7 H10.5 V13.5 H3.5 Z";
                                        reveal: true;
                                        show <=> State.wifi-show;
                                        text <=> State.wifi-pass;
                                        invalid: State.wifi-error;
                                        immediate: true;
                                        help: State.wifi-error ? @tr("La contraseña no es correcta.") : "";
                                        accepted => { root.wifi-join-now(); }
                                    }
                                    HorizontalLayout {
                                        alignment: end;
                                        spacing: 10px;
                                        Button {
                                            label: @tr("Cancelar");
                                            w: 110px;
                                            clicked => { root.wifi-back(); }
                                        }
                                        Button {
                                            label: State.wifi-join ? @tr("Conectando…") : @tr("Unirse");
                                            primary: true;
                                            w: 120px;
                                            enabled: !State.wifi-join;
                                            clicked => { root.wifi-join-now(); }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                p4 := Rectangle {
                    width: 100%;
                    height: 100%;
                    x: root.off(4);
                    opacity: root.op(4);
                    visible: self.opacity > 0.001;
                    animate x { duration: Motion.reduce ? 0ms : Motion.base; easing: ease-out; }
                    animate opacity { duration: Motion.reduce ? 0ms : Motion.base; easing: ease-out; }
                    VerticalLayout {
                        alignment: start;
                        spacing: 10px;
                        StepHeader {
                            title: @tr("Crea tu cuenta");
                            subtitle: @tr("Así te verás al iniciar sesión.");
                        }
                        Rectangle {
                            width: 100%;
                            height: 132px;
                            border-radius: Tokens.radiuslg;
                            clip: true;
                            Image {
                                source: root.wallpaper;
                                x: -24px;
                                y: -24px;
                                width: parent.width + 48px;
                                height: parent.height + 48px;
                                image-fit: cover;
                            }
                            Rectangle {
                                width: parent.width;
                                height: parent.height;
                                background: rgba(13, 18, 25, 0.3);
                            }
                            Rectangle {
                                width: parent.width - 2px;
                                height: parent.height - 2px;
                                x: 1px;
                                y: 1px;
                                border-radius: Tokens.radiuslg - 1px;
                                background: transparent;
                                border-width: 1px;
                                border-color: rgba(255, 255, 255, 0.12);
                            }
                            VerticalLayout {
                                alignment: center;
                                spacing: 8px;
                                HorizontalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: 56px;
                                        height: 56px;
                                        border-radius: 28px;
                                        background: Theme.accent;
                                        border-width: 2px;
                                        border-color: rgba(255, 255, 255, 0.9);
                                        drop-shadow-color: rgba(13, 18, 25, 0.28);
                                        drop-shadow-blur: 16px;
                                        drop-shadow-offset-y: 6px;
                                        Text {
                                            visible: State.initials != "";
                                            text: State.initials;
                                            color: Tokens.onAccent;
                                            font-size: 20px;
                                            font-weight: 600;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                            width: parent.width;
                                            height: parent.height;
                                        }
                                        MiniIcon {
                                            visible: State.initials == "";
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                            size: 30px;
                                            sw: 1.8px;
                                            ink: Tokens.onAccent;
                                            commands: "M8 3.4 A2.7 2.7 0 1 0 8 8.8 A2.7 2.7 0 1 0 8 3.4 Z M2.7 14 C3.5 11.5 5.6 10 8 10 C10.4 10 12.5 11.5 13.3 14";
                                        }
                                    }
                                }
                                Text {
                                    text: State.full-name == "" ? @tr("Tu nombre") : State.full-name;
                                    color: Tokens.onAccent;
                                    font-size: 15px;
                                    font-weight: 600;
                                    horizontal-alignment: center;
                                }
                                Text {
                                    text: "/home/" + (State.username == "" ? "usuario" : State.username);
                                    color: rgba(255, 255, 255, 0.82);
                                    font-size: 12px;
                                    horizontal-alignment: center;
                                }
                            }
                        }
                        Field {
                            label: @tr("Nombre completo");
                            icon: "M8 8 A2.5 2.5 0 1 0 8 3 A2.5 2.5 0 1 0 8 8 Z M3 13.5 C3.8 11.3 5.7 10 8 10 C10.3 10 12.2 11.3 13 13.5";
                            text <=> State.full-name;
                            invalid: State.full-name == "";
                            edited(t) => { root.name-edited(t); }
                            accepted => { root.continue-clicked(); }
                        }
                        if !State.username-editing : HorizontalLayout {
                            alignment: start;
                            padding-left: 2px;
                            spacing: 0px;
                            Text {
                                text: @tr("Usuario:");
                                color: Tokens.inkMuted;
                                font-size: 12px * (State.a11y-large-text ? 1.25 : 1.0);
                                vertical-alignment: center;
                            }
                            Text {
                                text: " " + State.username;
                                color: Tokens.inkStrong;
                                font-weight: 600;
                                font-size: 12px * (State.a11y-large-text ? 1.25 : 1.0);
                                vertical-alignment: center;
                            }
                            Text {
                                text: " · ";
                                color: Tokens.inkMuted;
                                font-size: 12px * (State.a11y-large-text ? 1.25 : 1.0);
                                vertical-alignment: center;
                            }
                            LinkText {
                                label: @tr("Cambiar");
                                w: 64px;
                                clicked => { State.username-editing = true; }
                            }
                        }
                        if State.username-editing : Field {
                            label: @tr("Nombre de usuario");
                            text <=> State.username;
                            help: State.username-error;
                            invalid: State.username-error != "";
                            edited(t) => { root.username-edited(t); }
                            accepted => { root.continue-clicked(); }
                        }
                        HorizontalLayout {
                            spacing: 12px;
                            Field {
                                label: @tr("Contraseña");
                                password: true;
                                icon: "M4.5 7 V5 A2.5 2.5 0 0 1 9.5 5 V7 M3.5 7 H10.5 V13.5 H3.5 Z";
                                reveal: true;
                                text <=> State.password;
                                invalid: State.password == "";
                                edited(_t) => { root.passwords-changed(); }
                                accepted => { root.continue-clicked(); }
                            }
                            Field {
                                label: @tr("Repetir");
                                password: true;
                                icon: "M4.5 7 V5 A2.5 2.5 0 0 1 9.5 5 V7 M3.5 7 H10.5 V13.5 H3.5 Z";
                                reveal: true;
                                text <=> State.password2;
                                invalid: State.password2 != State.password;
                                edited(_t) => { root.passwords-changed(); }
                                accepted => { root.continue-clicked(); }
                            }
                        }
                        HorizontalLayout {
                            spacing: 4px;
                            height: 16px;
                            for i in 4 : Rectangle {
                                horizontal-stretch: 1;
                                height: 4px;
                                border-radius: Tokens.radiuspill;
                                background: i < State.pw-strength ? Tokens.sysGreen : Tokens.bgControl;
                                animate background { duration: Motion.fast; }
                            }
                            Rectangle { width: 8px; background: transparent; }
                            Text {
                                text: State.pw-strength >= 3 ? @tr("Segura") : "";
                                color: Tokens.success;
                                font-size: 12px;
                                font-weight: 500;
                                vertical-alignment: center;
                            }
                            Rectangle { width: 4px; background: transparent; }
                            Text {
                                text: State.password2 != "" && !State.pw-match ? @tr("No coinciden")
                                    : (State.password2 != "" ? "✓ " + @tr("Coinciden") : "");
                                color: State.password2 != "" && !State.pw-match ? Tokens.danger : Tokens.success;
                                font-size: 12px;
                                font-weight: 500;
                                vertical-alignment: center;
                            }
                        }
                        ListCard {
                            IconRow {
                                title: @tr("Iniciar sesión automáticamente");
                                desc: @tr("No pedir la contraseña al encender");
                                icon: "M8 1.5 V7.5 M4.4 4 A5.5 5.5 0 1 0 11.6 4";
                                tint: Tokens.sysGray;
                                divider: false;
                                on <=> State.auto-login;
                            }
                        }
                    }
                }

                p5 := Rectangle {
                    width: 100%;
                    height: 100%;
                    x: root.off(5);
                    opacity: root.op(5);
                    visible: self.opacity > 0.001;
                    animate x { duration: Motion.reduce ? 0ms : Motion.base; easing: ease-out; }
                    animate opacity { duration: Motion.reduce ? 0ms : Motion.base; easing: ease-out; }
                    VerticalLayout {
                        alignment: start;
                        spacing: 20px;
                        StepHeader {
                            title: @tr("Zona horaria");
                            subtitle: @tr("Se ajusta sola con tu ubicación, o elige una ciudad.");
                            StepIcon { tint: root.step-tint(5); ClockIcon { ink: Tokens.onAccent; size: 30px; } }
                        }
                        VerticalLayout {
                            alignment: start;
                            spacing: 12px;
                            ListCard {
                                IconRow {
                                    title: @tr("Ajustar automáticamente");
                                    desc: State.tz-auto
                                        ? @tr("Según tu ubicación: ") + State.city-selected-name
                                        : @tr("Usa tu ubicación aproximada (requiere red)");
                                    icon: "M8 14.5 S12.5 10.3 12.5 7 A4.5 4.5 0 0 0 3.5 7 C3.5 10.3 8 14.5 8 14.5 Z M8 8.5 A1.5 1.5 0 1 0 8 5.5 A1.5 1.5 0 1 0 8 8.5 Z";
                                    tint: Tokens.sysBlue;
                                    divider: false;
                                    on <=> State.tz-auto;
                                }
                            }
                            VerticalLayout {
                                alignment: start;
                                spacing: 12px;
                                opacity: State.tz-auto ? 0.45 : 1.0;
                                animate opacity { duration: Motion.base; }
                                SearchField {
                                    placeholder: @tr("Buscar ciudad");
                                    text <=> State.city-search;
                                    edited(t) => { root.city-search-changed(t); }
                                }
                                ListCard {
                                    SectionLabel { text: @tr("CIUDADES"); }
                                    for name[i] in State.city-names : OptionRow {
                                        label: name;
                                        trailing: State.city-tz[i];
                                        check: true;
                                        selected: State.city-selected == State.city-tz[i];
                                        divider: i > 0;
                                        picked => {
                                            if (!State.tz-auto) { root.pick-city(name, State.city-tz[i]); }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                p6 := Rectangle {
                    width: 100%;
                    height: 100%;
                    x: root.off(6);
                    opacity: root.op(6);
                    visible: self.opacity > 0.001;
                    animate x { duration: Motion.reduce ? 0ms : Motion.base; easing: ease-out; }
                    animate opacity { duration: Motion.reduce ? 0ms : Motion.base; easing: ease-out; }
                    VerticalLayout {
                        alignment: start;
                        spacing: 20px;
                        StepHeader {
                            title: @tr("Elige tu aspecto");
                            subtitle: @tr("Se aplicará a GNOME. Puedes cambiarlo después en Ajustes.");
                            StepIcon { tint: root.step-tint(6); ContrastIcon { ink: Tokens.onAccent; size: 30px; } }
                        }
                        VerticalLayout {
                            alignment: start;
                            spacing: 18px;
                            HorizontalLayout {
                                alignment: center;
                                spacing: 20px;
                                ModeCard {
                                    selected: !Tokens.dark;
                                    picked => { Tokens.theme = "light"; }
                                }
                                ModeCard {
                                    preview-dark: true;
                                    selected: Tokens.dark;
                                    picked => { Tokens.theme = "dark"; }
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                spacing: 10px;
                                Text { text: @tr("Color de acento"); color: Tokens.inkStrong; font-size: 13px * (State.a11y-large-text ? 1.25 : 1.0); font-weight: 600; horizontal-alignment: center; }
                                HorizontalLayout {
                                    alignment: center;
                                    spacing: 10px;
                                    Swatch {
                                        c: Tokens.accent;
                                        selected: Theme.accent-index == 0;
                                        picked => { Theme.accent-index = 0; }
                                    }
                                    for a[i] in Theme.accents : Swatch {
                                        c: a.color;
                                        selected: Theme.accent-index == i + 1;
                                        picked => { Theme.accent-index = i + 1; }
                                    }
                                }
                                Text { text: Theme.accent-name; color: Tokens.inkMuted; font-size: 12px * (State.a11y-large-text ? 1.25 : 1.0); horizontal-alignment: center; }
                            }
                        }
                    }
                }

                p7 := Rectangle {
                    width: 100%;
                    height: 100%;
                    x: root.off(7);
                    opacity: root.op(7);
                    visible: self.opacity > 0.001;
                    animate x { duration: Motion.reduce ? 0ms : Motion.base; easing: ease-out; }
                    animate opacity { duration: Motion.reduce ? 0ms : Motion.base; easing: ease-out; }
                    VerticalLayout {
                        alignment: start;
                        spacing: 20px;
                        StepHeader {
                            title: "Git";
                            subtitle: @tr("Opcional. Puedes configurarlo después.");
                            StepIcon { tint: root.step-tint(7); GitIcon { ink: Tokens.onAccent; size: 30px; } }
                        }
                        VerticalLayout {
                            alignment: start;
                            spacing: 12px;
                            ListCard {
                                IconRow {
                                    title: @tr("Configurar Git ahora");
                                    desc: @tr("Nombre y correo para tus commits");
                                    icon: "M4.5 2.5 V13.5 M11.5 4.5 A1.5 1.5 0 1 0 11.5 7.5 A1.5 1.5 0 1 0 11.5 4.5 Z M11.5 7.5 C11.5 9.5 9 9.8 4.5 11.1";
                                    tint: Tokens.sysGreen;
                                    divider: false;
                                    on <=> State.git-on;
                                }
                            }
                            if State.git-on : VerticalLayout {
                                alignment: start;
                                spacing: 12px;
                                Field { label: @tr("Nombre"); text <=> State.git-name; }
                                Field { label: @tr("Correo"); text <=> State.git-email; placeholder: "tu@correo"; }
                            }
                            if !State.git-on : Text {
                                text: @tr("Desactivado: el nombre y el correo de Git quedan vacíos.");
                                color: Tokens.inkMuted;
                                font-size: 12px * (State.a11y-large-text ? 1.25 : 1.0);
                                horizontal-alignment: center;
                                wrap: word-wrap;
                            }
                        }
                    }
                }

                p8 := Rectangle {
                    width: 100%;
                    height: 100%;
                    x: root.off(8);
                    opacity: root.op(8);
                    visible: self.opacity > 0.001;
                    animate x { duration: Motion.reduce ? 0ms : Motion.base; easing: ease-out; }
                    animate opacity { duration: Motion.reduce ? 0ms : Motion.base; easing: ease-out; }
                    VerticalLayout {
                        alignment: start;
                        spacing: 16px;
                        StepHeader {
                            title: @tr("Todo listo");
                            subtitle: @tr("Revisa antes de aplicar. Puedes volver para cambiar algo.");
                            StepIcon { tint: root.step-tint(8); CheckIcon { ink: Tokens.onAccent; size: 30px; } }
                        }
                        ListCard {
                            SectionLabel { text: @tr("CUENTA"); }
                            SummaryRow {
                                k: @tr("Usuario"); v: State.username; divider: false;
                                icon: "M8 8 A2.5 2.5 0 1 0 8 3 A2.5 2.5 0 1 0 8 8 Z M3 13.5 C3.8 11.3 5.7 10 8 10 C10.3 10 12.2 11.3 13 13.5";
                                tint: Tokens.sysBlue;
                            }
                            SectionLabel { text: @tr("REGIÓN"); }
                            SummaryRow {
                                k: @tr("Idioma"); v: State.lang-selected-name; divider: false;
                                icon: "M8 1.5 A6.5 6.5 0 1 0 8 14.5 A6.5 6.5 0 1 0 8 1.5 Z M1.5 8 H14.5 M8 1.5 C9.8 3.3 10.6 5.5 10.6 8 C10.6 10.5 9.8 12.7 8 14.5 C6.2 12.7 5.4 10.5 5.4 8 C5.4 5.5 6.2 3.3 8 1.5";
                                tint: Tokens.sysPurple;
                            }
                            SummaryRow {
                                k: @tr("Teclado"); v: State.kb-names[State.kb-index];
                                icon: "M1.5 4 H14.5 V12 H1.5 Z M4 7 H5 M7 7 H9 M11 7 H12 M5 9.5 H11";
                                tint: Tokens.sysPurple;
                            }
                            SummaryRow {
                                k: @tr("Zona horaria");
                                v: State.city-selected + (State.tz-auto ? " · " + @tr("automática") : "");
                                icon: "M8 1.5 A6.5 6.5 0 1 0 8 14.5 A6.5 6.5 0 1 0 8 1.5 Z M8 4.5 V8 L10.5 9.5";
                                tint: Tokens.sysOrange;
                            }
                            SectionLabel { text: @tr("PREFERENCIAS"); }
                            SummaryRow {
                                k: @tr("Accesibilidad");
                                v: root.a11y-summary() == "" ? @tr("Sin cambios") : root.a11y-summary();
                                divider: false;
                                icon: "M8 1.5 A1.2 1.2 0 1 0 8 3.9 A1.2 1.2 0 1 0 8 1.5 Z M2.5 5.5 C4.3 6 6.1 6.3 8 6.3 C9.9 6.3 11.7 6 13.5 5.5 M8 6.3 V9.5 M5.8 14.5 L8 9.5 L10.2 14.5";
                                tint: Tokens.sysBlue;
                            }
                            SummaryRow {
                                k: @tr("Aspecto"); v: (Tokens.dark ? @tr("Oscuro") : @tr("Claro")) + " · " + Theme.accent-name;
                                icon: "M8 1.5 A6.5 6.5 0 1 0 8 14.5 Z M8 1.5 A6.5 6.5 0 0 1 8 14.5";
                                tint: Tokens.sysPurple;
                            }
                            SummaryRow {
                                k: "Git"; v: State.git-on ? State.git-name : @tr("Sin configurar");
                                icon: "M4.5 2.5 V13.5 M11.5 4.5 A1.5 1.5 0 1 0 11.5 7.5 A1.5 1.5 0 1 0 11.5 4.5 Z M11.5 7.5 C11.5 9.5 9 9.8 4.5 11.1";
                                tint: Tokens.sysGreen;
                            }
                        }
                    }
                }
        }

        footer := Rectangle {
            y: 584px;
            width: 100%;
            height: 64px;
            background: transparent;
            Rectangle {
                width: 100%;
                height: 1px;
                background: Tokens.line;
            }
            HorizontalLayout {
                y: 1px;
                width: 100%;
                height: 63px;
                padding-left: 20px;
                padding-right: 20px;
                spacing: 12px;
                accessible-role: none;
                accessible-label: @tr("Paso") + " " + State.step + " " + @tr("de") + " 8";
                Rectangle {
                    width: 30px;
                    height: 30px;
                    horizontal-stretch: 0;
                    border-radius: Tokens.radiuspill;
                    background: a11y-ta.has-hover ? Tokens.bgHover : transparent;
                    border-width: 1px;
                    border-color: Tokens.lineStrong;
                    animate background { duration: Motion.fast; }
                    MiniIcon {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        size: 16px;
                        ink: Tokens.inkMuted;
                        commands: "M8 8 A2.5 2.5 0 1 0 8 3 A2.5 2.5 0 1 0 8 8 Z M3 13.5 C3.8 11.3 5.7 10 8 10 C10.3 10 12.2 11.3 13 13.5";
                    }
                    a11y-ta := TouchArea {
                        clicked => { State.step = 2; }
                    }
                }
                Rectangle {
                    width: 320px;
                    height: 30px;
                    horizontal-stretch: 0;
                    background: transparent;
                    Text {
                        x: 0;
                        width: parent.width;
                        height: parent.height;
                        text: @tr("El idioma del sistema se aplica al reiniciar.");
                        color: Tokens.inkMuted;
                        font-size: 12px;
                        vertical-alignment: center;
                        wrap: no-wrap;
                        opacity: State.step == 1 ? 1 : 0;
                        animate opacity { duration: Motion.base; }
                    }
                    Text {
                        x: 0;
                        width: parent.width;
                        height: parent.height;
                        text: @tr("Otras opciones de red…");
                        color: Theme.accent-strong;
                        font-size: 13px;
                        font-weight: 500;
                        vertical-alignment: center;
                        wrap: no-wrap;
                        opacity: State.step == 3 ? 1 : 0;
                        animate opacity { duration: Motion.base; }
                    }
                    TouchArea {
                        clicked => { if (State.step == 3) { State.wifi-options = !State.wifi-options; } }
                    }
                }
                Rectangle { horizontal-stretch: 1; background: transparent; }
                Button {
                    label: @tr("Atrás");
                    h: Tokens.controlmd;
                    w: 96px;
                    horizontal-stretch: 0;
                    opacity: State.step > 1 ? 1 : 0;
                    clicked => { if (State.step > 1) { State.step = root.prev-step(State.step); } }
                }
                Button {
                    label: State.step == 8 ? @tr("Aplicar") : @tr("Continuar");
                    primary: true;
                    h: Tokens.controlmd;
                    w: 96px;
                    horizontal-stretch: 0;
                    clicked => { root.continue-clicked(); }
                }
            }
        }

        Rectangle {
            x: 1px;
            y: 1px;
            width: parent.width - 2px;
            height: parent.height - 2px;
            border-radius: Tokens.radiuslg - 1px;
            background: transparent;
            border-width: 1px;
            border-color: Tokens.windowInner;
        }

        if State.wifi-options : TouchArea {
            width: 100%;
            height: 100%;
            clicked => { State.wifi-options = false; }
        }
        if State.wifi-options : Rectangle {
            x: 20px;
            y: 584px - self.height - 8px;
            width: 300px;
            height: opts.preferred-height;
            border-radius: Tokens.radiuslg;
            background: Tokens.dark ? Tokens.bgRaised : Tokens.bgWindow;
            border-width: 1px;
            border-color: Tokens.line;
            drop-shadow-color: rgba(0, 0, 0, Tokens.dark ? 0.5 : 0.18);
            drop-shadow-blur: 24px;
            drop-shadow-offset-y: 8px;
            opts := VerticalLayout {
                padding-top: 4px;
                padding-bottom: 4px;
                OptionRow {
                    label: @tr("Conectar a una red oculta…");
                    icon: "M2 6.5 A9 9 0 0 1 14 6.5 M4.2 9 A5.8 5.8 0 0 1 11.8 9 M6.5 11.4 A2.4 2.4 0 0 1 9.5 11.4";
                    icon-tint: Tokens.sysCyan;
                    picked => { root.open-hidden-network(); }
                }
                OptionRow {
                    label: @tr("Mi equipo no se conecta a Internet");
                    divider: false;
                    picked => {
                        State.wifi-options = false;
                        State.step = root.next-step(3);
                    }
                }
            }
        }
    }

    prepare := Rectangle {
        width: parent.width;
        height: parent.height;
        opacity: State.step == 9 ? 1 : 0;
        transform-scale-x: Motion.reduce ? 100% : (State.step == 9 ? 100% : 103%);
        transform-scale-y: Motion.reduce ? 100% : (State.step == 9 ? 100% : 103%);
        visible: self.opacity > 0.001;
        animate opacity { duration: Motion.slow; easing: ease-out; }
        animate transform-scale-x { duration: Motion.slow; easing: ease-out; }
        animate transform-scale-y { duration: Motion.slow; easing: ease-out; }

        property <float> err: State.apply-error == "" ? 0.0 : 1.0;
        property <int> shown-phase: 0;
        property <string> status-text: root.status-label(prepare.shown-phase);
        property <float> status-op: 1.0;
        property <int> phase: State.prep-phase;
        status-timer := Timer {
            interval: Motion.reduce ? 1ms : 250ms;
            running: false;
            triggered => {
                prepare.shown-phase = prepare.phase;
                prepare.status-op = 1.0;
                self.running = false;
            }
        }
        changed phase => {
            if (Motion.reduce) {
                prepare.shown-phase = prepare.phase;
                prepare.status-op = 1.0;
            } else {
                prepare.status-op = 0.0;
                status-timer.start();
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 22px;
            HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: 48px;
                    height: 48px;
                    background: transparent;
                    SpinIcon {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        size: 36px;
                        sw: 2.2px;
                        ink: Tokens.onAccent;
                        opacity: (!Motion.reduce && prepare.err == 0) ? 1 : 0;
                        transform-rotation: (State.step == 9 && State.apply-error == "" && !Motion.reduce)
                            ? mod(animation-tick(), 900ms) / 900ms * 360deg
                            : 0deg;
                        animate opacity { duration: Motion.base; }
                    }
                    if Motion.reduce : HorizontalLayout {
                        alignment: center;
                        spacing: 6px;
                        for _d in 3 : Rectangle {
                            width: 6px;
                            height: 6px;
                            border-radius: 3px;
                            background: Tokens.onAccent;
                            opacity: prepare.err == 0 ? 1 : 0;
                            animate opacity { duration: Motion.base; }
                        }
                    }
                    Rectangle {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        width: 48px;
                        height: 48px;
                        border-radius: 13px;
                        background: Tokens.dangerFill;
                        opacity: prepare.err;
                        transform-scale-x: 80% + 20% * prepare.err;
                        transform-scale-y: 80% + 20% * prepare.err;
                        animate opacity { duration: Motion.base; }
                        animate transform-scale-x { duration: Motion.base; }
                        animate transform-scale-y { duration: Motion.base; }
                        Text {
                            text: "!";
                            color: Tokens.onAccent;
                            font-size: 28px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            width: parent.width;
                            height: parent.height;
                        }
                    }
                }
            }
            VerticalLayout {
                spacing: 8px;
                Text {
                    text: State.apply-error == "" ? @tr("Preparando tu escritorio") : @tr("No se pudo terminar la configuración");
                    color: Design.wallpaper-ink;
                    font-size: 28px;
                    font-weight: 650;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
                Text {
                    text: State.apply-error == "" ? @tr("Aplicando la configuración de Keel.") : State.apply-error;
                    color: Design.wallpaper-ink-muted;
                    font-size: 15px;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
            }
            if State.apply-error == "" : HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: 420px;
                    height: 6px;
                    border-radius: Tokens.radiuspill;
                    background: Design.wallpaper-glass;
                    clip: true;
                    Rectangle {
                        x: 0;
                        width: (State.prep-phase + 1) * (parent.width / 5);
                        height: 100%;
                        border-radius: Tokens.radiuspill;
                        background: Design.wallpaper-ink;
                        animate width { duration: Motion.reduce ? 0ms : 1200ms; easing: ease-out; }
                    }
                }
            }
            if State.apply-error == "" : Text {
                text: State.prep-status != "" ? State.prep-status : prepare.status-text;
                color: Design.wallpaper-ink-muted;
                font-size: 13px;
                horizontal-alignment: center;
                opacity: prepare.status-op;
                animate opacity { duration: Motion.reduce ? 0ms : 250ms; }
            }
            HorizontalLayout {
                alignment: center;
                LinkText {
                    label: State.show-details ? @tr("Ocultar detalles") : @tr("Mostrar detalles");
                    fg: Design.wallpaper-ink-faint;
                    w: 150px;
                    clicked => { State.show-details = !State.show-details; }
                }
            }
            Rectangle {
                width: 680px;
                height: State.show-details ? 170px : 0px;
                clip: true;
                opacity: State.show-details ? 1 : 0;
                border-radius: Tokens.radiuslg;
                background: Design.wallpaper-panel;
                border-width: 1px;
                border-color: Design.wallpaper-glass-border;
                animate height { duration: Motion.reduce ? 0ms : Motion.base; easing: ease-out; }
                animate opacity { duration: Motion.reduce ? 0ms : Motion.base; }
                Text {
                    x: 16px;
                    y: 12px;
                    width: parent.width - 32px;
                    height: parent.height - 24px;
                    text: State.log-text;
                    color: Design.wallpaper-ink-faint;
                    font-family: "DejaVu Sans Mono";
                    font-size: 12px;
                    wrap: word-wrap;
                    vertical-alignment: bottom;
                }
            }
            if State.apply-error != "" : HorizontalLayout {
                alignment: center;
                spacing: 10px;
                Button {
                    label: @tr("Volver a la configuración");
                    w: 210px;
                    clicked => { State.step = State.error-step; }
                }
                Button {
                    label: @tr("Volver a intentar");
                    primary: true;
                    w: 170px;
                    clicked => { root.apply(); }
                }
            }
        }

        Text {
            x: 0;
            y: parent.height - 56px - 18px;
            width: parent.width;
            text: @tr("No apagues el equipo. Se reiniciará solo cuando termine.");
            color: Design.wallpaper-ink-faint;
            font-size: 13px;
            horizontal-alignment: center;
            visible: State.apply-error == "";
        }
    }

    Rectangle {
        width: parent.width;
        height: parent.height;
        background: black;
        opacity: State.prep-black ? 1 : 0;
        visible: self.opacity > 0.001;
        animate opacity { duration: Motion.reduce ? 0ms : 600ms; }
    }

    }
}
