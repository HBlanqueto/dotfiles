{
	"$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
	"logo": {
		"type": "file",
		"source": "~/.config/fastfetch/logo.txt",
		"position": "left",
		"padding": {
			"top": 0,
			"right": 6
		}
	},
	"display": {
		"separator": ": "
	},
	"modules": [
		{
			"type": "custom",
			"key": " ",
			"format": ""
		},
		{
			"type": "custom",
			"key": " ",
			"format": ""
		},
		{
			"type": "custom",
			"key": " ",
			"format": ""
		},
		{
			"type": "command",
			"key": " ",
			"shell": "bash",
			"param": "-c",
			"text": ". /etc/os-release; printf '%s %s' \"$NAME\" \"${VERSION_CODENAME^}\"",
			"format": "\u001b[1m{result}\u001b[0m"
		},
		{
			"type": "command",
			"key": " ",
			"shell": "bash",
			"param": "-c",
			"text": ". /etc/os-release; echo $VERSION_ID",
			"format": "\u001b[1mVersion\u001b[0m \u001b[1m{result}\u001b[0m"
		},
		{
			"type": "custom",
			"key": " ",
			"format": ""
		},
		{
			"type": "host",
			"key": "Hardware",
			"format": "{family}"
		},
		{
			"type": "cpu",
			"key": "Processor",
			"format": "{name}"
		},
		{
			"type": "memory",
			"key": "Memory"
		},
		{
			"type": "gpu",
			"key": "Graphics",
			"format": "{vendor} {name} ({type})"
		},
		{
			"type": "board",
			"key": "Serial",
			"format": "{name}"
		}
	]
}
