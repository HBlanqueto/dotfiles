<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
  "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>keel-userd</vendor>
  <action id="io.github.HBlanqueto.keel.userd.users.manage">
    <description>Gestionar usuarios</description>
    <message>Se requiere autenticación de administrador para gestionar usuarios</message>
    <defaults>
      <allow_any>auth_admin_keep</allow_any>
      <allow_inactive>auth_admin_keep</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>
  <action id="io.github.HBlanqueto.keel.userd.users.password-own">
    <description>Cambiar la contraseña propia</description>
    <message>Se requiere autenticación para cambiar tu contraseña</message>
    <defaults>
      <allow_any>auth_self_keep</allow_any>
      <allow_inactive>auth_self_keep</allow_inactive>
      <allow_active>auth_self_keep</allow_active>
    </defaults>
  </action>
  <action id="io.github.HBlanqueto.keel.userd.home.modify-own">
    <description>Modificar el home propio</description>
    <defaults>
      <allow_any>yes</allow_any>
      <allow_inactive>yes</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
  </action>
  <action id="io.github.HBlanqueto.keel.userd.home.modify-any">
    <description>Modificar el home de otro usuario</description>
    <defaults>
      <allow_any>auth_admin_keep</allow_any>
      <allow_inactive>auth_admin_keep</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>
  <action id="io.github.HBlanqueto.keel.userd.packages.install-own">
    <description>Instalar paquetes propios</description>
    <defaults>
      <allow_any>yes</allow_any>
      <allow_inactive>yes</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
  </action>
  <action id="io.github.HBlanqueto.keel.userd.packages.install-any">
    <description>Instalar paquetes de otro usuario</description>
    <defaults>
      <allow_any>auth_admin_keep</allow_any>
      <allow_inactive>auth_admin_keep</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>
  <action id="io.github.HBlanqueto.keel.userd.capabilities.toggle">
    <description>Activar o desactivar capacidades</description>
    <defaults>
      <allow_any>auth_admin_keep</allow_any>
      <allow_inactive>auth_admin_keep</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>
</policyconfig>
