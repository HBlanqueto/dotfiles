// Neptunia component gallery for live preview with `slint-viewer`.
import { Theme, Metrics, NeptuniaMode } from "generated/neptunia.slint";

component Caption inherits Text {
    color: Theme.ink-muted;
    font-family: Theme.font-sans;
    font-size: Theme.text-caption-size;
    font-weight: 600;
    letter-spacing: 0.5px;
}

export component NpSwitch inherits Rectangle {
    in-out property <bool> checked;
    in property <bool> enabled: true;
    in property <bool> small;
    callback toggled(bool);
    width: small ? Metrics.switch-small-width : Metrics.switch-width;
    height: small ? Metrics.switch-small-height : Metrics.switch-height;
    border-radius: self.height / 2;
    background: checked ? Theme.accent : Theme.bg-control;
    border-width: checked ? 0px : 1px;
    border-color: Theme.line;
    opacity: enabled ? 1 : Metrics.switch-disabled-opacity;
    animate background { duration: Theme.dur-fast; }
    knob := Rectangle {
        property <length> size: root.small ? Metrics.switch-small-knob : Metrics.switch-knob;
        property <length> inset: root.small ? Metrics.switch-small-inset : Metrics.switch-inset;
        property <length> travel: root.small ? Metrics.switch-small-travel : Metrics.switch-travel;
        width: self.size;
        height: self.size;
        y: self.inset;
        x: root.checked ? self.inset + self.travel : self.inset;
        border-radius: self.size / 2;
        background: #ffffff;
        drop-shadow-blur: Theme.shadow-knob-blur;
        drop-shadow-offset-y: Theme.shadow-knob-offset-y;
        drop-shadow-color: Theme.shadow-knob-color;
        animate x { duration: Theme.dur-fast; easing: ease-out; }
    }
    TouchArea {
        enabled: root.enabled;
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }
}

export component NpButton inherits Rectangle {
    in property <string> text;
    in property <string> kind: "secondary";
    callback clicked;
    height: Metrics.button-height;
    min-width: label.preferred-width + 2 * Metrics.button-padding-x;
    border-radius: Theme.radius-button;
    background: kind == "primary" ? (ta.has-hover ? Theme.accent-hover : Theme.accent)
        : kind == "danger" ? Theme.danger-fill
        : kind == "plain" ? (ta.has-hover ? Theme.accent-soft : transparent)
        : (ta.has-hover ? Theme.bg-hover : Theme.bg-control);
    animate background { duration: Theme.dur-fast; }
    label := Text {
        text: root.text;
        font-family: Theme.font-sans;
        font-size: Metrics.button-font-size;
        font-weight: Metrics.button-font-weight;
        color: root.kind == "primary" ? Theme.on-accent
            : root.kind == "danger" ? Theme.on-danger
            : root.kind == "plain" ? Theme.accent-strong : Theme.ink-strong;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}

export component NpSegmented inherits Rectangle {
    in property <[string]> items;
    in-out property <int> current;
    callback changed(int);
    background: Theme.bg-control;
    border-radius: Metrics.segmented-radius;
    height: Metrics.segmented-segment-height + 2 * Metrics.segmented-padding;
    HorizontalLayout {
        padding: Metrics.segmented-padding;
        spacing: Metrics.segmented-gap;
        for item[i] in root.items: Rectangle {
            min-width: t.preferred-width + 2 * Metrics.segmented-segment-padding-x;
            border-radius: Metrics.segmented-segment-radius;
            background: i == root.current ? Theme.bg-surface : transparent;
            drop-shadow-blur: i == root.current ? Theme.shadow-knob-blur : 0px;
            drop-shadow-offset-y: Theme.shadow-knob-offset-y;
            drop-shadow-color: Theme.shadow-knob-color;
            t := Text {
                text: item;
                font-family: Theme.font-sans;
                font-size: Metrics.segmented-font-size;
                font-weight: Metrics.segmented-font-weight;
                color: i == root.current ? Theme.ink-strong : Theme.ink-muted;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            TouchArea {
                clicked => {
                    root.current = i;
                    root.changed(i);
                }
            }
        }
    }
}

export struct ToolTab { label: string, icon: string }

export component NpToolbarTabs inherits Rectangle {
    in property <[ToolTab]> tabs;
    in-out property <int> current;
    in property <bool> bare;
    background: bare ? transparent : Theme.bg-sunken;
    border-radius: bare ? 0px : Metrics.toolbar-tabs-container-radius;
    border-width: bare ? 0px : 1px;
    border-color: Theme.line;
    HorizontalLayout {
        alignment: center;
        padding: Metrics.toolbar-tabs-container-padding;
        spacing: Metrics.toolbar-tabs-container-gap;
        for tab[i] in root.tabs: Rectangle {
            min-width: Metrics.toolbar-tabs-tab-min-width;
            border-radius: Metrics.toolbar-tabs-tab-radius;
            background: i == root.current ? Theme.bg-hover : (ta.has-hover ? Theme.bg-control : transparent);
            animate background { duration: Theme.dur-fast; }
            VerticalLayout {
                padding-top: Metrics.toolbar-tabs-tab-padding-top;
                padding-bottom: Metrics.toolbar-tabs-tab-padding-bottom;
                padding-left: 8px;
                padding-right: 8px;
                spacing: Metrics.toolbar-tabs-tab-gap;
                alignment: center;
                HorizontalLayout {
                    alignment: center;
                    Path {
                        width: Metrics.toolbar-tabs-tab-icon;
                        height: Metrics.toolbar-tabs-tab-icon;
                        viewbox-width: 16;
                        viewbox-height: 16;
                        commands: tab.icon;
                        fill: transparent;
                        stroke: i == root.current ? Theme.accent-strong : Theme.ink-muted;
                        stroke-width: 1.6px;
                    }
                }
                Text {
                    text: tab.label;
                    font-family: Theme.font-sans;
                    font-size: Metrics.toolbar-tabs-tab-font-size;
                    font-weight: Metrics.toolbar-tabs-tab-font-weight;
                    color: i == root.current ? Theme.accent-strong : Theme.ink-muted;
                    horizontal-alignment: center;
                }
            }
            ta := TouchArea { clicked => { root.current = i; } }
        }
    }
}

export component NpSlider inherits Rectangle {
    in-out property <float> value: 0.5;
    height: Metrics.slider-height;
    min-width: 160px;
    Rectangle {
        y: (parent.height - self.height) / 2;
        height: Metrics.slider-track;
        border-radius: self.height / 2;
        background: Theme.bg-control;
    }
    Rectangle {
        x: 0;
        y: (parent.height - self.height) / 2;
        width: knob.x + knob.width / 2;
        height: Metrics.slider-track;
        border-radius: self.height / 2;
        background: Theme.accent;
    }
    knob := Rectangle {
        width: Metrics.slider-knob;
        height: Metrics.slider-knob;
        x: root.value * (root.width - self.width);
        y: (root.height - self.height) / 2;
        border-radius: self.width / 2;
        background: #ffffff;
        drop-shadow-blur: Theme.shadow-knob-blur;
        drop-shadow-offset-y: Theme.shadow-knob-offset-y;
        drop-shadow-color: Theme.shadow-knob-color;
    }
    TouchArea {
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) { root.set(self.mouse-x); }
        }
        moved => { root.set(self.mouse-x); }
    }
    function set(mx: length) {
        root.value = max(0, min(1, (mx - knob.width / 2) / (root.width - knob.width)));
    }
}

export component Demo inherits Window {
    title: "Neptunia — galería";
    preferred-width: 720px;
    preferred-height: 560px;
    background: Theme.bg-sunken;
    default-font-family: Theme.font-sans;

    Rectangle {
        x: 32px;
        y: 32px;
        width: parent.width - 64px;
        height: parent.height - 64px;
        background: Theme.bg-window;
        border-radius: Theme.radius-lg;
        border-width: 1px;
        border-color: Theme.window-outer;
        drop-shadow-blur: Theme.shadow-window-blur;
        drop-shadow-offset-y: Theme.shadow-window-offset-y;
        drop-shadow-color: Theme.shadow-window-color;
        clip: true;

        VerticalLayout {
            padding: Theme.space-6;
            spacing: Theme.space-4;

            HorizontalLayout {
                spacing: Theme.space-3;
                Text {
                    text: "Neptunia";
                    color: Theme.ink-strong;
                    font-size: Theme.text-title-1-size;
                    font-weight: Theme.text-title-1-weight;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; }
                NpSegmented {
                    items: ["Claro", "Oscuro", "Tintado"];
                    current: Theme.mode == NeptuniaMode.dark ? 1 : Theme.mode == NeptuniaMode.dark-tint ? 2 : 0;
                    changed(i) => {
                        Theme.mode = i == 1 ? NeptuniaMode.dark : i == 2 ? NeptuniaMode.dark-tint : NeptuniaMode.light;
                    }
                }
            }

            NpToolbarTabs {
                tabs: [
                    { label: "General", icon: "M8 5.8a2.2 2.2 0 1 0 0 4.4a2.2 2.2 0 1 0 0-4.4M8 1.5v2M8 12.5v2M1.5 8h2M12.5 8h2" },
                    { label: "Apariencia", icon: "M8 2.5a5.5 5.5 0 1 0 0 11a5.5 5.5 0 1 0 0-11M8 2.5v11" },
                    { label: "Teclado", icon: "M3 4h10a1.5 1.5 0 0 1 1.5 1.5v5A1.5 1.5 0 0 1 13 12H3a1.5 1.5 0 0 1-1.5-1.5v-5A1.5 1.5 0 0 1 3 4M5 9.5h6" },
                    { label: "Privacidad", icon: "M5 7h6a1.5 1.5 0 0 1 1.5 1.5v3.5A1.5 1.5 0 0 1 11 13.5H5A1.5 1.5 0 0 1 3.5 12V8.5A1.5 1.5 0 0 1 5 7M5.5 7V5a2.5 2.5 0 0 1 5 0v2" },
                ];
            }

            Caption { text: "INTERRUPTOR · 32 × 18"; }
            HorizontalLayout {
                spacing: Theme.space-4;
                alignment: start;
                NpSwitch { checked: true; }
                NpSwitch { }
                NpSwitch { checked: true; enabled: false; }
                NpSwitch { checked: true; small: true; }
            }

            Caption { text: "DESLIZADOR"; }
            NpSlider { value: 0.4; }

            Caption { text: "BOTONES"; }
            HorizontalLayout {
                spacing: Theme.space-2;
                alignment: start;
                NpButton { text: @tr("Continuar"); kind: "primary"; }
                NpButton { text: @tr("Cancelar"); }
                NpButton { text: @tr("Borrar disco"); kind: "danger"; }
                NpButton { text: @tr("Más opciones"); kind: "plain"; }
            }
            Rectangle { vertical-stretch: 1; }
        }
    }
}
