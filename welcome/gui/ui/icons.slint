// Line icons as Slint paths.
import { Tokens } from "theme.slint";

export component Icon inherits Path {
    in property <length> size: 22px;
    in property <color> ink: Tokens.inkMuted;
    in property <length> sw: 1.6px;

    width: size;
    height: size;
    viewbox-width: 24;
    viewbox-height: 24;
    fill: transparent;
    stroke: ink;
    stroke-width: sw;
    stroke-line-cap: round;
    stroke-line-join: round;
}

export component GlobeIcon inherits Icon {
    commands: "M 3 12 A 9 9 0 1 0 21 12 A 9 9 0 1 0 3 12 Z M 3 12 L 21 12 M 12 3 C 14.5 5.6 15.8 8.6 15.8 12 C 15.8 15.4 14.5 18.4 12 21 C 9.5 18.4 8.2 15.4 8.2 12 C 8.2 8.6 9.5 5.6 12 3 Z";
}

export component WifiIcon inherits Icon {
    sw: 2px;
    commands: "M 2 8.5 A 15 15 0 0 1 22 8.5 M 5 12 A 10.5 10.5 0 0 1 19 12 M 8.5 15.5 A 5.5 5.5 0 0 1 15.5 15.5 M 11.2 19 A 0.8 0.8 0 1 0 12.8 19 A 0.8 0.8 0 1 0 11.2 19 Z";
}

export component ClockIcon inherits Icon {
    commands: "M 3 12 A 9 9 0 1 0 21 12 A 9 9 0 1 0 3 12 Z M 12 7 L 12 12 L 15 14";
}

export component ContrastIcon inherits Rectangle {
    in property <length> size: 22px;
    in property <color> ink: Tokens.inkMuted;
    width: size;
    height: size;
    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 24;
        viewbox-height: 24;
        fill: root.ink;
        stroke-width: 0px;
        commands: "M 12 3 A 9 9 0 0 1 12 21 Z";
    }
    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 24;
        viewbox-height: 24;
        fill: transparent;
        stroke: root.ink;
        stroke-width: 1.7px;
        commands: "M 3 12 A 9 9 0 1 0 21 12 A 9 9 0 1 0 3 12 Z";
    }
}

export component GitIcon inherits Icon {
    commands: "M 4 6 A 2.2 2.2 0 1 0 8 6 A 2.2 2.2 0 1 0 4 6 Z M 4 18 A 2.2 2.2 0 1 0 8 18 A 2.2 2.2 0 1 0 4 18 Z M 16 9 A 2.2 2.2 0 1 0 20 9 A 2.2 2.2 0 1 0 16 9 Z M 6 8.2 L 6 15.8 M 18 11.2 C 18 14.2 14 14.7 7.5 16.7";
}

export component CheckIcon inherits Icon {
    sw: 1.9px;
    commands: "M 5 12.5 L 9.5 17 L 19 7.5";
}

export component SpinIcon inherits Icon {
    sw: 2.4px;
    commands: "M 12 2.5 A 9.5 9.5 0 1 1 2.5 12";
}

export component MiniIcon inherits Icon {
    viewbox-width: 16;
    viewbox-height: 16;
    sw: 1.6px;
}
