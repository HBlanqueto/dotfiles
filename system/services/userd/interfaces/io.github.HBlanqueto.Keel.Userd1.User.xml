<interface name="io.github.HBlanqueto.Keel.Userd1.User">
  <method name="ResetPassword">
    <arg name="recovery_key" type="s" direction="in"/>
    <arg name="new_password" type="s" direction="in"/>
  </method>
  <method name="SetPassword">
    <arg name="password" type="s" direction="in"/>
    <arg name="old_password" type="s" direction="in"/>
  </method>
  <method name="AdminResetPassword">
    <arg name="new_password" type="s" direction="in"/>
  </method>
  <property name="Backend" type="s" access="read"/>
  <property name="Managed" type="b" access="read"/>
  <property name="Name" type="s" access="read"/>
  <property name="State" type="s" access="read"/>
  <property name="Uid" type="u" access="read"/>
</interface>
